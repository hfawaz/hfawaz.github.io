---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.png';
import Layout from '../layouts/Layout.astro';
import Project from '../components/Project.astro';
import Publication from '../components/Publication.astro';
import { profile, projects } from '../data/profile';
import { selectedPublications } from '../data/publications';
---

<Layout>
  <div class="wrap">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow location">
          <span class="status-dot" aria-hidden="true"></span> RIYADH, SAUDI
          ARABIA
        </p>
        <h1 id="intro-title">
          Curiosity meets
          <br />
          <em>applied AI.</em>
        </h1>
        <p class="hero-intro">
          I’m Hassan, an AI expert and researcher turning advances in machine
          learning into useful systems.
        </p>
        <p class="hero-current">
          Currently {profile.role} at{' '}
          <a href={profile.organizationUrl}>{profile.organization}</a>.
          Previously Beyond Limits, Ericsson, and Besedo.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/work/">
            Explore my work <span aria-hidden="true">↗</span>
          </a>
          <a class="button secondary" href={`mailto:${profile.email}`}>
            Get in touch <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="social-links">
          {profile.links.slice(0, 3).map((link) => (
            <a href={link.url}>
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
      <div class="portrait-block">
        <div class="portrait-frame">
          <Image
            src={portrait}
            alt="Hassan Ismail Fawaz"
            width={520}
            height={600}
            widths={[320, 520, 780]}
            sizes="(max-width: 760px) 85vw, 380px"
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
          <span class="portrait-label">
            A researcher’s mindset.
            <br />
            An engineer’s approach.
          </span>
        </div>
        <div class="portrait-caption">
          <span>Hassan Ismail Fawaz</span>
          <span>PhD, Computer & Data Science</span>
        </div>
      </div>
    </section>
    <div class="focus-strip">
      <span class="eyebrow">AREAS OF FOCUS</span>
      <span>Generative AI</span>
      <span>Deep learning</span>
      <span>Time series</span>
      <span>Applied research</span>
    </div>
    <section class="section" id="work" aria-labelledby="work-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">01 / SELECTED WORK</p>
          <h2 id="work-title">From questions to code.</h2>
        </div>
        <a class="text-link" href="/work/">
          More about my work <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <Project project={project} />
        ))}
      </div>
    </section>
    <section class="section" id="publications" aria-labelledby="papers-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / RESEARCH</p>
          <h2 id="papers-title">Selected publications.</h2>
        </div>
        <a class="text-link" href="/publications/">
          All publications <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="publication-list">
        {selectedPublications.map((paper) => (
          <Publication paper={paper} compact />
        ))}
      </div>
    </section>
    <section class="about-band" aria-labelledby="about-title">
      <div>
        <p class="eyebrow">03 / A LITTLE BACKGROUND</p>
        <h2 id="about-title">
          Research foundations.
          <br />
          <em>Real-world curiosity.</em>
        </h2>
      </div>
      <div>
        <p>
          My path has taken me from a PhD in time series classification in
          France to building machine learning systems across content moderation,
          telecommunications, and generative AI.
        </p>
        <a class="text-link" href="/about/">
          The longer story <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="contact-band">
      <p class="eyebrow">LET’S CONNECT</p>
      <h2>
        Good work starts
        <br />
        with a conversation.
      </h2>
      <a class="text-link" href={`mailto:${profile.email}`}>
        {profile.email} <span aria-hidden="true">↗</span>
      </a>
    </section>
  </div>
</Layout>
