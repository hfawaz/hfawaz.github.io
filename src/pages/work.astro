---
import Layout from '../layouts/Layout.astro';
import Project from '../components/Project.astro';
import OpenSource from '../components/OpenSource.astro';
import { impact, number, githubStars, checkedDate } from '../data/impact';
import { experience, projects } from '../data/profile';
---

<Layout
  title="Work"
  description="Selected machine learning research, open-source projects, and industry experience from Hassan Ismail Fawaz."
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">RESEARCH & ENGINEERING</p>
      <h1>
        Ideas into <em>practice.</em>
      </h1>
      <p>Building on research to solve problems with machine learning.</p>
    </header>
    <aside class="github-summary">
      <p>
        <strong data-github-total>{number(githubStars)}</strong> GitHub stars
        across my public repositories
      </p>
      <span>
        Checked{' '}
        <span data-github-updated>{checkedDate(impact.github.checkedAt)}</span>{' '}
        · <a href={impact.github.source}>View repositories ↗</a>
      </span>
    </aside>
    <section class="section first-section" aria-labelledby="projects-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">OPEN RESEARCH</p>
          <h2 id="projects-title">Selected projects.</h2>
        </div>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <Project project={project} />
        ))}
      </div>
    </section>
    <section
      class="section repository-section"
      aria-labelledby="repositories-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">MORE OPEN-SOURCE TOOLS</p>
          <h2 id="repositories-title">Built to be shared.</h2>
        </div>
      </div>
      <div class="repository-list">
        {impact.github.repositories
          .filter((repo) =>
            [
              'hfawaz/bigdata18',
              'hfawaz/cd-diagram',
              'hfawaz/aaltd18',
              'hfawaz/ijcnn19ensemble',
            ].includes(repo.name),
          )
          .map((repo) => (
            <a href={repo.url}>
              <span>{repo.name.split('/')[1]}</span>
              <span class="repo-stars" data-github-repo={repo.name}>
                <span aria-hidden="true">☆</span>{' '}
                <span data-github-stars>{number(repo.stars)}</span> stars
              </span>
            </a>
          ))}
      </div>
    </section>
    <OpenSource />
    <section class="section" aria-labelledby="experience-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">INDUSTRY</p>
          <h2 id="experience-title">Where I’ve worked.</h2>
        </div>
      </div>
      <div class="experience-list">
        {experience.map((job) => (
          <article class="experience">
            <div>
              <h3>
                <a href={job.url}>{job.company} ↗</a>
              </h3>
              {job.current && <span class="current-tag">Current</span>}
            </div>
            <div>
              <h4>{job.role}</h4>
              <p>{job.detail}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
