---
import Layout from '../layouts/Layout.astro';
import Project from '../components/Project.astro';
import { experience, projects } from '../data/profile';
---

<Layout
  title="Work"
  description="Selected machine learning research, open-source projects, and industry experience from Hassan Ismail Fawaz."
>
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">RESEARCH & ENGINEERING</p>
      <h1>
        Ideas into <em>practice.</em>
      </h1>
      <p>Building on research to solve problems with machine learning.</p>
    </header>
    <section class="section first-section" aria-labelledby="projects-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">OPEN RESEARCH</p>
          <h2 id="projects-title">Selected projects.</h2>
        </div>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <Project project={project} />
        ))}
      </div>
    </section>
    <section class="section" aria-labelledby="experience-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">INDUSTRY</p>
          <h2 id="experience-title">Where I’ve worked.</h2>
        </div>
      </div>
      <div class="experience-list">
        {experience.map((job) => (
          <article class="experience">
            <div>
              <h3>
                <a href={job.url}>{job.company} ↗</a>
              </h3>
              {job.current && <span class="current-tag">Current</span>}
            </div>
            <div>
              <h4>{job.role}</h4>
              <p>{job.detail}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="about-band">
      <div>
        <p class="eyebrow">SHARING KNOWLEDGE</p>
        <h2>
          Open source.
          <br />
          <em>Open learning.</em>
        </h2>
      </div>
      <div>
        <p>
          Alongside research, I’ve contributed to resources for learning and
          applying deep learning to time series.
        </p>
        <div class="stacked-links">
          <a
            class="text-link"
            href="https://keras.io/examples/timeseries/timeseries_classification_from_scratch/"
          >
            Time series classification with Keras ↗
          </a>
          <a
            class="text-link"
            href="https://github.com/uea-machine-learning/sktime-dl"
          >
            sktime-dl on GitHub ↗
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
