---
import type { projects } from '../data/profile';
import { repositoryImpact, number, checkedDate, impact } from '../data/impact';
interface Props {
  project: (typeof projects)[number];
}
const { project } = Astro.props;
const repository = repositoryImpact(project.url);
---

<article class="project-card">
  <div class:list={['project-art', project.visual]} aria-hidden="true">
    <span class="project-number">{project.number} / RESEARCH NOTES</span>
    <svg viewBox="0 0 320 130" fill="none">
      {project.visual === 'waves' && (
        <>
          <path d="M0 70h35l13-35 18 68 20-84 18 89 18-48 19 10h179" />
          <path
            class="faint"
            d="M0 92h23l25-40 18 65 20-78 18 82 18-38 19 9h179"
          />
          <path
            class="faint"
            d="M0 45h35l13-28 18 51 20-60 18 70 18-44 19 11h179"
          />
        </>
      )}
      {project.visual === 'grid' && (
        <>
          {[0, 1, 2, 3, 4].map((row) =>
            [0, 1, 2, 3, 4, 5, 6, 7].map((col) => (
              <rect
                x={35 + col * 32}
                y={5 + row * 25}
                width="19"
                height="13"
                rx="2"
                opacity={0.15 + ((row * 3 + col * 7) % 8) / 10}
              />
            )),
          )}
        </>
      )}
      {project.visual === 'domains' && (
        <>
          <circle cx="95" cy="65" r="48" />
          <circle cx="225" cy="65" r="48" />
          <path d="M124 65h71m-10-10 10 10-10 10" />
          {[0, 1, 2, 3, 4].map((n) => (
            <>
              <circle
                class="dot"
                cx={72 + (n % 3) * 19}
                cy={43 + Math.floor(n / 3) * 27}
                r="4"
              />
              <circle
                class="dot"
                cx={203 + (n % 3) * 19}
                cy={52 + Math.floor(n / 3) * 25}
                r="4"
              />
            </>
          ))}
        </>
      )}
    </svg>
  </div>
  <div class="project-content">
    {repository && (
      <a
        class="star-badge"
        href={`${repository.url}/stargazers`}
        title={`GitHub stars checked ${checkedDate(impact.github.checkedAt)}`}
      >
        <span aria-hidden="true">☆</span> {number(repository.stars)} stars
      </a>
    )}
    <p class="eyebrow">{project.category}</p>
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    <a class="text-link" href={project.url}>
      {project.label} <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
