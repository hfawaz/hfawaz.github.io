---
import github from '../assets/icons/github.svg?raw';
import scholar from '../assets/icons/googlescholar.svg?raw';
import linkedin from '../assets/icons/linkedin.svg?raw';
import keras from '../assets/icons/keras.svg?raw';
import huggingface from '../assets/icons/huggingface.svg?raw';

import orcid from '../assets/icons/orcid.svg?raw';
import arxiv from '../assets/icons/arxiv.svg?raw';
import dblp from '../assets/icons/dblp.svg?raw';
import researchgate from '../assets/icons/researchgate.svg?raw';
import semanticscholar from '../assets/icons/semanticscholar.svg?raw';
import x from '../assets/icons/x.svg?raw';

const lineIcon = (paths: string) =>
  `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${paths}</svg>`;
// SVG markup is bundled from trusted local assets; never from API responses.
const icons = {
  github,
  scholar,
  linkedin,
  keras,
  huggingface,
  orcid,
  arxiv,
  dblp,
  researchgate,
  semanticscholar,
  x,
  about: lineIcon(
    '<circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/>',
  ),
  work: lineIcon(
    '<rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12a20 20 0 0 0 18 0M12 12v3"/>',
  ),
  publications: lineIcon(
    '<path d="M12 5v16M12 5C9 3 5 3 2 4v15c3-1 7-1 10 2 3-3 7-3 10-2V4c-3-1-7-1-10 1Z"/>',
  ),
  pdf: lineIcon(
    '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  ),
  code: lineIcon('<path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16"/>'),
  email: lineIcon(
    '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  ),
};
interface Props {
  name: keyof typeof icons;
}
const { name } = Astro.props;
---

<span
  class:list={['icon', `icon-${name}`]}
  aria-hidden="true"
  set:html={icons[name]}
/>
