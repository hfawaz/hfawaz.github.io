---
import github from '../assets/icons/github.svg?raw';
import scholar from '../assets/icons/googlescholar.svg?raw';
import linkedin from '../assets/icons/linkedin.svg?raw';
import keras from '../assets/icons/keras.svg?raw';
import huggingface from '../assets/icons/huggingface.svg?raw';

const lineIcon = (paths: string) =>
  `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${paths}</svg>`;
// SVG markup is bundled from trusted local assets; never from API responses.
const icons = {
  github,
  scholar,
  linkedin,
  keras,
  huggingface,
  pdf: lineIcon(
    '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  ),
  code: lineIcon('<path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16"/>'),
  email: lineIcon(
    '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  ),
  globe: lineIcon(
    '<circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/>',
  ),
};
interface Props {
  name: keyof typeof icons;
}
const { name } = Astro.props;
---

<span
  class:list={['icon', `icon-${name}`]}
  aria-hidden="true"
  set:html={icons[name]}
/>
